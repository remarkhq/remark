NODE_ENV=development
PORT=3000
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_WIDGET_URL=http://localhost:3000/widget.js
PUBLIC_DOCS_URL=http://localhost:5173

GITHUB_OAUTH_CLIENT_ID=replace-with-client-id
GITHUB_OAUTH_CLIENT_SECRET=replace-with-client-secret
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3000/auth/github/callback

REMARK_BOT_USERNAME=remark-bot
REMARK_BOT_TOKEN=replace-with-local-development-token

SESSION_SECRET=replace-with-a-long-random-local-secret

GITHUB_ALLOWED_REPOSITORIES=owner/comments
GITHUB_DEFAULT_ISSUE_LABEL=remark

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60
